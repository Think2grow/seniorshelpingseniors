---
import BrandBar from '../components/BrandBar.astro';
import '../styles/global.css';
const { title = 'Seniors Helping Seniors® Southern Utah' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Official franchise location for Seniors Helping Seniors® Southern Utah. In-home senior care with compassion, reliability, and community presence." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-neutral-900 overflow-x-hidden">
    <BrandBar />
    <slot name="fullbleed" />
    <main class="flex-1 w-full mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
