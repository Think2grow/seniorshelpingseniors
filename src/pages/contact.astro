---
import MainLayout from '../../layouts/MainLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import Footer from '../../components/Footer.astro';
---

<MainLayout title="Contact | Seniors Helping Seniors® Southern Utah">
  <section class="max-w-4xl mx-auto">
    <div class="bg-white border border-neutral-200 rounded-2xl shadow-sm p-6 md:p-10">
      <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-bold">Contact</h1>
        <p class="text-neutral-700">
          Call <a href="tel:4359002465">435-900-2465</a> or send a message using the form below. Text message consent is optional.
        </p>
      </div>

      <div class="mt-6">
        <ContactForm legend="Contact form" />
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4">
          <div class="text-sm font-semibold text-neutral-600">Office</div>
          <div class="text-sm text-neutral-800 mt-1">840 S. Black Alder Drive</div>
          <div class="text-sm text-neutral-800">St. George, Utah 84790</div>
        </div>
        <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4">
          <div class="text-sm font-semibold text-neutral-600">Email</div>
          <div class="text-sm mt-1"><a href="mailto:info@southernutahshs.com">info@southernutahshs.com</a></div>
        </div>
        <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4">
          <div class="text-sm font-semibold text-neutral-600">License</div>
          <div class="text-sm text-neutral-800 mt-1">2025-PCA-F25-117485</div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
